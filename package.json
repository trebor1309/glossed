{
  "name": "glossed",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.jsx",
    "lint:fix": "eslint src --fix --ext .js,.jsx",
    "lint:e2e": "eslint e2e scripts/run-e2e.mjs scripts/run-auth-e2e.mjs scripts/run-functional-e2e.mjs scripts/run-financial-v2-stripe-pilot.mjs scripts/check-bundle-size.mjs scripts/check-edge-functions.mjs scripts/check-checkout-v2-stripe-contract.mjs scripts/check-release-transfer-v2-contract.mjs scripts/check-financial-remediation-v2-contract.mjs scripts/check-provider-payouts-v2-contract.mjs scripts/check-admin-foundation-contract.mjs scripts/check-admin-operations-contract.mjs scripts/check-admin-disputes-contract.mjs scripts/check-admin-finance-contract.mjs scripts/check-admin-incidents-contract.mjs scripts/check-admin-account-management-contract.mjs scripts/check-admin-ux-consolidation-1-contract.mjs scripts/check-admin-ux-consolidation-2-contract.mjs scripts/check-mission-lifecycle-v2-contract.mjs scripts/run-supabase-sql-tests.mjs playwright.config.js playwright.auth.config.js playwright.functional.config.js --quiet",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:functions": "node scripts/check-edge-functions.mjs",
    "check:stripe-v2": "node scripts/check-checkout-v2-stripe-contract.mjs",
    "check:release-v2": "node scripts/check-release-transfer-v2-contract.mjs",
    "check:remediation-v2": "node scripts/check-financial-remediation-v2-contract.mjs",
    "check:payouts-v2": "node scripts/check-provider-payouts-v2-contract.mjs",
    "check:admin": "node scripts/check-admin-foundation-contract.mjs",
    "check:admin-operations": "node scripts/check-admin-operations-contract.mjs",
    "check:admin-disputes": "node scripts/check-admin-disputes-contract.mjs",
    "check:admin-finance": "node scripts/check-admin-finance-contract.mjs",
    "check:admin-incidents": "node scripts/check-admin-incidents-contract.mjs",
    "check:admin-accounts": "node scripts/check-admin-account-management-contract.mjs",
    "check:admin-ux-1": "node scripts/check-admin-ux-consolidation-1-contract.mjs",
    "check:admin-ux-2": "node scripts/check-admin-ux-consolidation-2-contract.mjs",
    "check:mission-lifecycle-v2": "node scripts/check-mission-lifecycle-v2-contract.mjs",
    "check:sql": "supabase db lint --local --level warning",
    "test:sql": "node scripts/run-supabase-sql-tests.mjs",
    "test:pilot:financial-v2": "node scripts/run-financial-v2-stripe-pilot.mjs",
    "pretest:e2e": "vite build --mode e2e",
    "test:e2e": "node scripts/run-e2e.mjs",
    "pretest:e2e:headed": "vite build --mode e2e",
    "test:e2e:headed": "node scripts/run-e2e.mjs --headed",
    "pretest:e2e:ui": "vite build --mode e2e",
    "test:e2e:ui": "node scripts/run-e2e.mjs --ui",
    "test:e2e:auth": "node scripts/run-auth-e2e.mjs",
    "test:e2e:auth:headed": "node scripts/run-auth-e2e.mjs --headed",
    "test:e2e:functional": "node scripts/run-functional-e2e.mjs",
    "test:e2e:functional:headed": "node scripts/run-functional-e2e.mjs --headed",
    "check-unused": "npx unimported",
    "pretty": "prettier --write .",
    "clean-all": "npm run lint && npm run check-unused && npm run pretty",
    "check": "npm run lint && npm run lint:e2e && npm run check:stripe-v2 && npm run check:release-v2 && npm run check:remediation-v2 && npm run check:payouts-v2 && npm run check:admin && npm run check:admin-operations && npm run check:admin-disputes && npm run check:admin-finance && npm run check:admin-incidents && npm run check:admin-accounts && npm run check:admin-ux-1 && npm run check:admin-ux-2 && npm run check:mission-lifecycle-v2 && npm run build && npm run check:bundle",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@react-google-maps/api": "^2.20.7",
    "@stripe/connect-js": "^3.4.6",
    "@stripe/react-connect-js": "^3.4.4",
    "@stripe/react-stripe-js": "^5.3.0",
    "@stripe/stripe-js": "^8.3.0",
    "@supabase/supabase-js": "^2.112.2",
    "bootstrap-icons": "^1.13.1",
    "dayjs": "^1.11.18",
    "framer-motion": "^12.23.22",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.545.0",
    "react": "^19.1.1",
    "react-calendar": "^6.0.0",
    "react-dom": "^19.1.1",
    "react-easy-crop": "^5.5.6",
    "react-router-dom": "^7.18.2",
    "swr": "^2.3.6",
    "uuid": "^13.0.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/eslint-parser": "^7.28.4",
    "@babel/preset-react": "^7.27.1",
    "@eslint/js": "^9.37.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.37.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "supabase": "^2.51.0",
    "tailwindcss": "^3.4.14",
    "vite": "^7.1.7",
    "vite-plugin-checker": "^0.11.0"
  }
}

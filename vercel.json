{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "glossed.app" }],
      "destination": "https://www.glossed.app/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "admin.glossed.app" }],
      "destination": "/admin.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "admin.glossed.app" }],
      "destination": "/admin.html"
    },
    { "source": "/(.*)", "destination": "/" }
  ]
}

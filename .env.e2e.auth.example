# Target deployment. Use a test or preview deployment connected to the test Supabase project.
E2E_BASE_URL=https://your-test-deployment.example
E2E_SUPABASE_URL=https://your-test-project.supabase.co
# Optional: only required when the target uses Vercel Deployment Protection.
E2E_VERCEL_BYPASS_SECRET=

# Dedicated, fully onboarded test accounts. Never use personal or production credentials.
E2E_CLIENT_EMAIL=client-e2e@example.test
E2E_CLIENT_PASSWORD=replace-me
E2E_PRO_EMAIL=pro-e2e@example.test
E2E_PRO_PASSWORD=replace-me
E2E_ADMIN_EMAIL=admin-e2e@example.test
E2E_ADMIN_PASSWORD=replace-me

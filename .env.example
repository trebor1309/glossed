# Frontend (public values bundled by Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-browser-key

# Vercel webhook proxy (server-only; never prefix secrets with VITE_)
SUPABASE_STRIPE_WEBHOOK_URL=https://your-project.supabase.co/functions/v1/stripe-payment-webhook

# Supabase Edge Function secrets (configure with `supabase secrets set`)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
STRIPE_SECRET_KEY=sk_test_or_live_value
STRIPE_WEBHOOK_SECRET=whsec_value
APP_URL=https://your-app.example
ALLOWED_ORIGINS=https://your-app.example,http://localhost:5173

# Optional manual Stripe Connect smoke-test script
SUPABASE_CREATE_STRIPE_ACCOUNT_URL=https://your-project.supabase.co/functions/v1/create-stripe-account
SUPABASE_ACCESS_TOKEN=an-authenticated-user-access-token

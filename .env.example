# Frontend (public values bundled by Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-browser-key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_or_live_public_value
VITE_ADMIN_ALLOWED_HOSTS=admin.glossed.app
# Canonical application origin used in Supabase Auth emails (no trailing path)
VITE_PUBLIC_APP_URL=https://glossed.vercel.app
# Optional release identifier shown in sanitized operational incidents
VITE_APP_RELEASE=git-commit-or-release-name

# Public legal operator details (mandatory before commercial launch)
VITE_LEGAL_ENTITY_NAME=Robert Heinen
VITE_LEGAL_ENTITY_FORM=Entreprise individuelle (personne physique)
VITE_LEGAL_OPERATOR_TRADE_NAME=EWCS
VITE_LEGAL_REGISTERED_OFFICE=Route du Barrage 36, 4960 Malmedy, Belgique
VITE_LEGAL_ENTERPRISE_NUMBER=1028.639.270
VITE_LEGAL_VAT_NUMBER=BE 1028.639.270
VITE_LEGAL_CONTACT_EMAIL=contact@ewcs.be
VITE_LEGAL_CONTACT_PHONE=+32 80 78 66 58

# Vercel webhook proxy (server-only; never prefix secrets with VITE_)
SUPABASE_STRIPE_WEBHOOK_URL=https://your-project.supabase.co/functions/v1/stripe-payment-webhook

# Supabase Edge Function secrets (configure with `supabase secrets set`)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
STRIPE_SECRET_KEY=sk_test_or_live_value
STRIPE_WEBHOOK_SECRET=whsec_value
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_connect_value
RESEND_API_KEY=re_sending_access_key
NOTIFICATION_EMAIL_FROM=Glossed <notifications@your-domain.example>
CONTACT_EMAIL_FROM=Glossed Support <notifications@your-domain.example>
CONTACT_EMAIL_TO=contact@ewcs.be
# Optional dedicated HMAC secret; falls back to CONTACT_FORM_HASH_SECRET
CLIENT_INCIDENT_HASH_SECRET=a-long-random-server-only-secret
APP_URL=https://your-app.example
ALLOWED_ORIGINS=https://glossed.vercel.app,https://admin.glossed.app,http://localhost:5173

# Optional manual Stripe Connect smoke-test script
SUPABASE_CREATE_STRIPE_ACCOUNT_URL=https://your-project.supabase.co/functions/v1/create-stripe-account
SUPABASE_ACCESS_TOKEN=an-authenticated-user-access-token
